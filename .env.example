# Contact form email delivery (optional).
# Without these, the /api/contact route validates and logs submissions so the
# site deploys and "works" out of the box. Add these on Vercel to enable real
# email delivery via Resend (https://resend.com).

# Resend API key — required to actually send emails.
RESEND_API_KEY=

# Where contact messages are delivered. Defaults to the email in data/resume.ts.
CONTACT_TO_EMAIL=

# The verified "from" address. Defaults to Resend's shared onboarding sender.
# For production, verify your own domain in Resend and use e.g.
# "Anushree Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
